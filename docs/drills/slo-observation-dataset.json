    "completed_at": "2026-10-24T00:00:00Z"
  },
  "methodology": {
    "slot_cadence_ms": 400,
    "active_publishers": 7,
    "quorum_m": 3,
    "telemetry_sources": [
      "Prometheus node exporter /metrics",
      "JSON-RPC getLatestBlock and account state readback",
      "WebSocket stream participation monitor"
    ],
    "missing_sample_policy": "Strict zero-tolerance (unreachable endpoints or missing slot observations consume error budget as failures)",
    "slo_definitions": {
      "SLO-1": "Freshness: feed_age <= 10 slots",
      "SLO-2": "Participation: active publisher signatures >= 3 of 7",
      "SLO-3": "Price Accuracy: deviation <= 50 bps against canonical reference median",
      "SLO-4": "API Availability: HTTP 200 within 200ms latency ceiling",
      "SLO-5": "Publish Success: Transaction committed on-chain with 0x0 status",
      "SLO-6": "Reader/Indexer Lag: P99 block lag <= 5 slots"
    }
  },
